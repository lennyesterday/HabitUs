// Kopiere diese Datei nach Config/Secrets.xcconfig und trag die Werte aus dem
// Supabase-Dashboard ein (Project Settings → API). Secrets.xcconfig wird nicht committet.
// Nur den anon key eintragen, NIE den service role key.
// "//" startet in xcconfig einen Kommentar, darum steht in der URL "/$()/".
SUPABASE_URL = https:/$()/DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY = DEIN_ANON_KEY
